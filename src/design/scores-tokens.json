{
  "breakpoints": {
    "tablet": 760,
    "desktop": 1024,
    "wide": 1440
  },
  "primitive": {
    "black": "#080b0d",
    "charcoal": "#181d22",
    "raised": "#292929",
    "white": "#fafafa",
    "grey": "#aaa",
    "line": "#2d343b",
    "gold": "#dfc081",
    "space1": "4px",
    "space2": "8px",
    "space3": "12px",
    "space4": "16px",
    "space6": "24px",
    "space8": "32px",
    "radius": "12px",
    "fontSmall": "12px",
    "fontBody": "14px",
    "slate": "#69788a"
  },
  "semantic": {
    "canvas": "var(--rv-primitive-black)",
    "surface": "var(--rv-primitive-charcoal)",
    "text": "var(--rv-primitive-white)",
    "muted": "var(--rv-primitive-grey)",
    "divider": "var(--rv-primitive-line)",
    "focus": "var(--accent)",
    "interactive": "#62d6cc",
    "interactiveHover": "#8ae5dc",
    "sectionGap": "16px",
    "neutralSurface": "linear-gradient(155deg, #1b2127 0%, #161b20 100%)",
    "subtleHighlight": "rgba(255, 255, 255, 0.035)"
  },
  "component": {
    "contentMax": "1200px",
    "gutter": "12px",
    "cardGap": "6px",
    "cardRadius": "var(--rv-primitive-radius)",
    "cardHeight": "98px",
    "cardPadding": "12px",
    "cardCentre": "96px",
    "logo": "32px",
    "score": "34px",
    "navHeight": "68px",
    "touch": "44px"
  },
  "surface": {
    "resting": "linear-gradient(145deg, #242a30 0%, #1c2229 48%, #171b20 100%)",
    "live": "radial-gradient(ellipse at 48% 0%, color-mix(in srgb, var(--accent) 9%, transparent), transparent 78%), linear-gradient(145deg, #2a2d30 0%, #22272c 54%, #1b2026 100%)",
    "upcoming": "linear-gradient(145deg, #202934 0%, #1a222c 48%, #141b24 100%)",
    "completed": "linear-gradient(145deg, #21252b 0%, #1b1f24 50%, #15191e 100%)",
    "edge": "inset 0 0 0 1px rgba(180, 193, 208, 0.10), inset 0 1px 0 rgba(235, 241, 249, 0.025)",
    "liveEdge": "inset 0 0 0 1px color-mix(in srgb, var(--accent) 20%, transparent), inset 0 1px 0 rgba(235, 241, 249, 0.035)",
    "hoverHighlight": "inset 0 0 0 1px rgba(205, 215, 228, 0.10)",
    "mutedText": "#bcc0c6",
    "teamBlend": "linear-gradient(100deg, color-mix(in srgb, var(--scores-home-team-color, var(--rv-primitive-slate)) 10.5%, #151a20) 0%, color-mix(in srgb, var(--scores-home-team-color, var(--rv-primitive-slate)) 9%, #151a20) 25%, color-mix(in srgb, color-mix(in srgb, var(--scores-home-team-color, var(--rv-primitive-slate)) 50%, var(--scores-away-team-color, var(--rv-primitive-slate))) 9%, #151a20) 50%, color-mix(in srgb, var(--scores-away-team-color, var(--rv-primitive-slate)) 9%, #151a20) 75%, color-mix(in srgb, var(--scores-away-team-color, var(--rv-primitive-slate)) 10.5%, #151a20) 100%)",
    "teamFadeDown": "linear-gradient(180deg, rgba(3, 5, 8, 0.06), rgba(3, 5, 8, 0.12) 40%, rgba(3, 5, 8, 0.28))",
    "completedFadeDown": "linear-gradient(180deg, rgba(3, 5, 8, 0.13), rgba(3, 5, 8, 0.20) 45%, rgba(3, 5, 8, 0.35))",
    "upcomingFadeDown": "linear-gradient(180deg, rgba(3, 5, 8, 0.10), rgba(3, 5, 8, 0.16) 45%, rgba(3, 5, 8, 0.32))",
    "liveAmbient": "radial-gradient(ellipse at 50% 0%, color-mix(in srgb, var(--accent) 1.5%, transparent), transparent 75%)"
  },
  "surfaceSelectors": [
    ".rv-surface",
    ".settings-row",
    ".settings-row-panel",
    ".account-empty",
    ".community-composer",
    ".community-post",
    ".community-search",
    ".community-empty",
    ".community-compose-dialog",
    ".tracker-editor",
    ".tracker-player-picker",
    ".tracker-empty",
    ".match-header",
    ".game-detail-dialog",
    ".explore-metrics > div",
    ".explore-player-row",
    ".explore-leader",
    ".explore-schedule > article",
    ".explore-empty",
    ".onboarding-leagues > button",
    "dialog[aria-label=\"Search teams and games\"]",
    ".favourite-players > div",
    ".game-surface",
    ".pregame-comparison",
    ".pregame-side-sections",
    ".pregame-bottom-grid > section",
    ".pregame-full-dialog",
    ".standings-dialog"
  ]
}
